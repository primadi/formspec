// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/go-postgres
{
  "name": "Go",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    // Python: pakai versi bawaan distro (apt) — mode "latest" harus
    // mengunduh source python.org + compile dari source, dan itu gagal
    // (curl error 56, connection reset) saat build. sdk/python cuma butuh
    // Python ≥ 3.9, jadi python3 dari apt sudah cukup.
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided"
    },
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
    // Java (JDK 17 + Maven) — commented out to save ~319 MB disk + JVM RAM.
    // Enable when working on sdk/java:
    // 1. Uncomment the block below
    // 2. Dev Containers: Rebuild and Reopen in Container
    //"ghcr.io/devcontainers/features/java:1": {
    //	"version": "17",
    //	"installMaven": true,
    //	"installGradle": false
    //},
    // .NET SDK — commented out to save ~613 MB disk.
    // Enable when working on sdk/dotnet:
    // 1. Uncomment the block below
    // 2. Dev Containers: Rebuild and Reopen in Container
    //"ghcr.io/devcontainers/features/dotnet:2.5.0": {
    //	"version": "lts"
    //},
    // Ruby — commented out to save ~151 MB disk (rarely needed).
    // Enable when working on sdk/ruby:
    // 1. Uncomment the block below
    // 2. Dev Containers: Rebuild and Reopen in Container
    //"ghcr.io/devcontainers/features/ruby:2.0.0": {
    //	"version": "latest"
    //}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Vizards.deepseek-v4-for-copilot",
        "ltmoerdani.opencode-copilot-chat",
        "phgn.vscode-starlark",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "dbcode.dbcode",
        "Anthropic.claude-code",
        "redhat.vscode-yaml"
      ]
    }
  },

  // Features to add to the dev container. More info: https:// containers.dev/features.
  // "features": {},

  // Configure tool-specific properties.
  // "customizations": {},

  // Forward ports ke host (Windows/Mac). Prefix 1 untuk menghindari tabrakan.
  // 19000 = Garage S3 API | 19003 = Garage Admin API + metrics
  // 16379 = Valkey | 11025 = Mailpit SMTP | 18025 = Mailpit UI
  // 18080 TIDAK di-forward: dev server API/UI berjalan di :8080 di dalam
  // container; forward 18080 memicu rewrite URL di tool browser
  // (18080 → 18081) yang membuat open_browser_page timeout.
  // Keep this on IPv4 localhost to avoid Docker's flaky IPv6 forwarding in this environment.
  "forwardPorts": [19000, 19003, 16379, 11025, 18025],

  // 18080 (publish compose untuk :8080 di dalam container) tetap terdeteksi
  // VS Code sebagai "active port" dan di-auto-forward ke 18081 walau tidak
  // masuk forwardPorts. Blokir di sini supaya tidak pernah di-forward.
  "portsAttributes": {
    "18080": {
      "label": "Dev Server (tidak di-forward)",
      "onAutoForward": "ignore"
    }
  },

  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "cd renderers/react-shadcn && [ -f package.json ] && npm install || true"

  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
