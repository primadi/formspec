# FormSpec Devcontainer Environment
#
# Docker Compose auto-loads this file for interpolation, and it is also passed
# to services that declare `env_file: .env`.
#
# PostgreSQL (production only) — uncomment saat dibutuhkan:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=formspec
# POSTGRES_HOSTNAME=localhost

# Object storage (Garage, service `garage`) — read by the Garage container on
# boot (`--single-node --default-bucket`) to create the default access key and
# bucket. Dev-only credentials, safe to commit; production uses a
# `kind: Datastore` with `credential_ref` instead.
GARAGE_DEFAULT_ACCESS_KEY=GKbf7437fbebf1e19e1bf384bd9c867016
GARAGE_DEFAULT_SECRET_KEY=316c95b1d56fe95e82b455ece5c47dcf82b8dd23beca7e6ea23b996bdce3731d
GARAGE_DEFAULT_BUCKET=formspec

# Same credentials for the app container, under the names the
# `driver: garage` datastore resolver falls back to when a `kind: Datastore`
# omits `connection.extra.access_key`/`secret_key`. Endpoint and bucket still
# come from the manifest (or default to garage:3900/formspec).
FORMSPEC_GARAGE_ACCESS_KEY=GKbf7437fbebf1e19e1bf384bd9c867016
FORMSPEC_GARAGE_SECRET_KEY=316c95b1d56fe95e82b455ece5c47dcf82b8dd23beca7e6ea23b996bdce3731d

