{
  "title": "Form Spec",
  "description": "FormSpec defines an input/edit layout (Frontend §4).\n",
  "type": "object",
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FormAction"
      }
    },
    "entity": {
      "type": "string"
    },
    "mode": {
      "description": "create | edit | view",
      "type": "string"
    },
    "render": {
      "$ref": "#/$defs/FormRenderDecl",
      "nullable": true
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FormSection"
      }
    },
    "submit": {
      "$ref": "#/$defs/FormSubmit",
      "nullable": true
    }
  },
  "required": [
    "entity"
  ],
  "additionalProperties": false
}