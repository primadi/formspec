{
  "title": "Timeline Spec",
  "description": "TimelineSpec defines a chronological event journal (Frontend §13).\n",
  "type": "object",
  "properties": {
    "bind_param": {
      "type": "string"
    },
    "bind_value": {
      "type": "string"
    },
    "date_field": {
      "type": "string"
    },
    "display": {
      "$ref": "#/$defs/TimelineDisplay",
      "nullable": true
    },
    "empty_state": {
      "type": "string"
    },
    "entity": {
      "description": "@schema {example: \"clinic.medical_record\"}",
      "type": "string",
      "examples": [
        "clinic.medical_record"
      ]
    },
    "event_field": {
      "type": "string"
    },
    "group_by": {
      "description": "date | month | year | none",
      "type": "string"
    },
    "page_size": {
      "type": "integer"
    },
    "public": {
      "description": "If true (default), a route /module/timeline/\u003cname\u003e is auto-generated.",
      "type": "boolean",
      "examples": [
        "true"
      ],
      "nullable": true
    },
    "sort": {
      "description": "asc | desc (default desc)",
      "type": "string"
    }
  },
  "required": [
    "entity"
  ],
  "additionalProperties": false
}