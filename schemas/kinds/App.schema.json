{
  "title": "App Spec",
  "description": "AppSpec is the root project manifest (Core §4.4). A Workspace MAY contain\nmore than one App; all Apps in a workspace run simultaneously, mounted at\ntheir own RootURL.\n",
  "type": "object",
  "properties": {
    "access": {
      "$ref": "#/$defs/AppAccess",
      "description": "@schema {example: \"private\", enum: [\"private\", \"public\"]}"
    },
    "app_renderer": {
      "description": "@schema {example: \"no-nav\", enum: [\"sidebar-nav\", \"topnav\", \"no-nav\"]}",
      "type": "string",
      "enum": [
        "sidebar-nav",
        "topnav",
        "no-nav"
      ],
      "examples": [
        "no-nav"
      ]
    },
    "auth_config_ref": {
      "description": "per-App auth strategy config",
      "type": "string"
    },
    "consumes": {
      "description": "cross-app interfaces needed → grant request",
      "type": "array",
      "items": {
        "$ref": "#/$defs/AppConsume"
      }
    },
    "menu": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MenuItem"
      }
    },
    "modules": {
      "description": "@schema {example: \"[clinic, pharmacy]\"}",
      "type": "array",
      "items": {
        "type": "string"
      },
      "examples": [
        "[clinic, pharmacy]"
      ]
    },
    "persist_backend": {
      "description": "@schema {example: \"jsonb-persist\"}",
      "type": "string",
      "examples": [
        "jsonb-persist"
      ]
    },
    "publishes": {
      "description": "cross-app interfaces offered",
      "type": "array",
      "items": {
        "$ref": "#/$defs/AppInterface"
      }
    },
    "renderers": {
      "description": "Renderers maps a VisualSpecKind name → renderer for the whole App",
      "type": "object",
      "additionalProperties": {}
    },
    "root_url": {
      "description": "@schema {example: \"/app/klinik\", pattern: \"^(/|/app(/.*)?)$\"}",
      "type": "string",
      "examples": [
        "/app/klinik"
      ],
      "pattern": "^(/|/app(/.*)?)$"
    },
    "stack_family": {
      "description": "@schema {example: \"react-shadcn\"}",
      "type": "string",
      "examples": [
        "react-shadcn"
      ]
    },
    "theme_ref": {
      "description": "@schema {example: \"ocean-blue\"}",
      "type": "string",
      "examples": [
        "ocean-blue"
      ]
    },
    "vendor": {
      "description": "@schema {example: \"acme-corp\"}",
      "type": "string",
      "examples": [
        "acme-corp"
      ]
    },
    "version": {
      "description": "@schema {example: \"1.0.0\"}",
      "type": "string",
      "examples": [
        "1.0.0"
      ]
    }
  },
  "required": [
    "version",
    "vendor",
    "root_url"
  ],
  "additionalProperties": false
}