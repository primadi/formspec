{
  "title": "Page Spec",
  "description": "PageSpec defines a routed screen composing blocks (Frontend §3).\n`blocks` and `tabs` are mutually exclusive.\n",
  "type": "object",
  "properties": {
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PageBlock"
      }
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "layout": {
      "$ref": "#/$defs/PageLayout",
      "nullable": true
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public": {
      "description": "If true (default), a route is generated for this page. Set false to restrict to embedding only.",
      "type": "boolean",
      "examples": [
        "true"
      ],
      "nullable": true
    },
    "route": {
      "description": "@schema {example: \"/orders/:id\"}",
      "type": "string",
      "examples": [
        "/orders/:id"
      ]
    },
    "tabs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PageTab"
      }
    },
    "title": {
      "description": "@schema {example: \"Order {order.number}\"}",
      "type": "string",
      "examples": [
        "Order {order.number}"
      ]
    }
  },
  "required": [
    "route",
    "title"
  ],
  "additionalProperties": false
}