{
  "title": "Environment Spec",
  "description": "EnvironmentSpec defines one deployment target (platform/04-control-plane.md §2).\n",
  "type": "object",
  "properties": {
    "key_ref": {
      "description": "KeyRef is the location of the platform signing key (e.g. kms://prod-signing).",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/EnvironmentMode",
      "description": "Mode is the deployment environment mode — dev | prod."
    },
    "policy": {
      "description": "Policy names the kind: Policy that applies to this environment.",
      "type": "string"
    },
    "resource_planes": {
      "description": "ResourcePlanes lists the resource plane endpoints for this environment.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/EnvironmentPlane"
      }
    },
    "resource_pool": {
      "description": "Resource pool strategy",
      "type": "string",
      "enum": [
        "shared",
        "exclusive"
      ]
    },
    "tier": {
      "description": "Deployment tier",
      "type": "string",
      "enum": [
        "standalone",
        "cloud",
        "enterprise"
      ]
    }
  },
  "required": [
    "mode",
    "tier",
    "resource_pool",
    "key_ref",
    "policy"
  ],
  "additionalProperties": false
}