{
  "title": "Table Spec",
  "description": "TableSpec defines a list/browse view (Frontend §5).\n",
  "type": "object",
  "properties": {
    "batch_edit": {
      "description": "Batch editing: fields editable across a multi-row selection. Framework runs update per row, partial failure reported per row.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bulk_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TableAction"
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TableColumn"
      }
    },
    "default_sort": {
      "description": "@schema {example: \"-created_at\"}",
      "type": "string",
      "examples": [
        "-created_at"
      ]
    },
    "entity": {
      "description": "@schema {example: \"billing.order\"}",
      "type": "string",
      "examples": [
        "billing.order"
      ]
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FilterSpec"
      }
    },
    "fixed_filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FilterSpec"
      }
    },
    "page_size": {
      "type": "integer"
    },
    "public": {
      "description": "If true (default), a route /module/table/\u003cname\u003e is auto-generated. Set false for embed-only tables.",
      "type": "boolean",
      "examples": [
        "true"
      ],
      "nullable": true
    },
    "realtime": {
      "type": "boolean"
    },
    "row_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TableAction"
      }
    },
    "search": {
      "type": "boolean"
    }
  },
  "required": [
    "entity"
  ],
  "additionalProperties": false
}