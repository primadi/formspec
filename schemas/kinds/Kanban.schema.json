{
  "title": "Kanban Spec",
  "description": "KanbanSpec defines a drag-and-drop status board (Frontend §12).\n",
  "type": "object",
  "properties": {
    "card_template": {
      "$ref": "#/$defs/KanbanCard",
      "nullable": true
    },
    "columns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/KanbanColumn"
      }
    },
    "entity": {
      "description": "@schema {example: \"helpdesk.ticket\"}",
      "type": "string",
      "examples": [
        "helpdesk.ticket"
      ]
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FilterSpec"
      }
    },
    "fixed_filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FilterSpec"
      }
    },
    "max_cards_per_column": {
      "type": "integer"
    },
    "position_field": {
      "description": "field storing user-adjustable position (e.g. \"queue_position\")",
      "type": "string"
    },
    "public": {
      "description": "If true (default), a route /module/kanban/\u003cname\u003e is auto-generated.",
      "type": "boolean",
      "examples": [
        "true"
      ],
      "nullable": true
    },
    "realtime": {
      "description": "default true (§12)",
      "type": "boolean",
      "nullable": true
    },
    "row_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TableAction"
      }
    },
    "search": {
      "type": "boolean"
    },
    "sortable": {
      "description": "enable within-column drag-to-reorder",
      "type": "boolean"
    },
    "status_field": {
      "description": "@schema {example: \"status\"}",
      "type": "string",
      "examples": [
        "status"
      ]
    }
  },
  "required": [
    "entity",
    "status_field"
  ],
  "additionalProperties": false
}