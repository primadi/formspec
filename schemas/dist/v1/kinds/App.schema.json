{
  "title": "App Spec",
  "description": "AppSpec is the root project manifest (Core §4.4). A Workspace MAY contain\nmore than one App; all Apps in a workspace run simultaneously, mounted at\ntheir own RootURL.\n",
  "type": "object",
  "properties": {
    "access": {
      "$ref": "#/$defs/AppAccess",
      "description": "@schema {example: \"private\", enum: [\"private\", \"public\"], description: \"Auth axis: private (default, secure by default) | public — orthogonal to app_renderer\"}"
    },
    "app_renderer": {
      "description": "Chrome archetype (frontend/05-app-kinds.md): sidebar-nav | topnav | no-nav — no-nav means truly no navigation",
      "type": "string",
      "enum": [
        "sidebar-nav",
        "topnav",
        "no-nav"
      ],
      "examples": [
        "no-nav"
      ]
    },
    "auth_config_ref": {
      "description": "Per-App auth strategy config (kind: Config)",
      "type": "string"
    },
    "chrome": {
      "$ref": "#/$defs/AppChrome",
      "description": "Chrome fine-tunes which shell chrome elements render (frontend/",
      "nullable": true
    },
    "consumes": {
      "description": "cross-app interfaces needed → grant request",
      "type": "array",
      "items": {
        "$ref": "#/$defs/AppConsume"
      }
    },
    "logo": {
      "description": "Brand mark icon (lucide name) next to the title in the shell brand bar",
      "type": "string",
      "examples": [
        "package"
      ]
    },
    "menu": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MenuItem"
      }
    },
    "modules": {
      "description": "Modules mounted by this App — manifests outside these modules are excluded from the App bundle",
      "type": "array",
      "items": {
        "type": "string"
      },
      "examples": [
        "[clinic, pharmacy]"
      ]
    },
    "persist_backend": {
      "description": "Entity persist backend (backend/04-persist-backend.md), e.g. jsonb-persist",
      "type": "string",
      "examples": [
        "jsonb-persist"
      ]
    },
    "publishes": {
      "description": "cross-app interfaces offered",
      "type": "array",
      "items": {
        "$ref": "#/$defs/AppInterface"
      }
    },
    "renderers": {
      "description": "Renderers maps a VisualSpecKind name → renderer for the whole App",
      "type": "object",
      "additionalProperties": {}
    },
    "root_url": {
      "description": "@schema {example: \"/app/klinik\", pattern: \"^(/|/app(/.*)?)$\"}",
      "type": "string",
      "examples": [
        "/app/klinik"
      ],
      "pattern": "^(/|/app(/.*)?)$"
    },
    "stack_family": {
      "description": "Shell implementation (frontend/03-renderer-kind.md), e.g. react-shadcn",
      "type": "string",
      "examples": [
        "react-shadcn"
      ]
    },
    "theme_ref": {
      "description": "Theme kind name applied per-App (frontend/05-app-kinds.md §6)",
      "type": "string",
      "examples": [
        "ocean-blue"
      ]
    },
    "title": {
      "description": "Human-readable display name (spaces allowed) — brand bar + document.title; metadata.name stays the machine identifier",
      "type": "string",
      "examples": [
        "Acme Corp Portal"
      ]
    },
    "vendor": {
      "description": "@schema {example: \"acme-corp\"}",
      "type": "string",
      "examples": [
        "acme-corp"
      ]
    },
    "version": {
      "description": "@schema {example: \"1.0.0\"}",
      "type": "string",
      "examples": [
        "1.0.0"
      ]
    }
  },
  "required": [
    "version",
    "vendor",
    "root_url"
  ],
  "additionalProperties": false
}