{
  "title": "Table Spec",
  "description": "TableSpec defines a list/browse view (Frontend §5).\n",
  "type": "object",
  "properties": {
    "bulk_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TableAction"
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TableColumn"
      }
    },
    "default_sort": {
      "type": "string"
    },
    "entity": {
      "type": "string"
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FilterSpec"
      }
    },
    "fixed_filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FilterSpec"
      }
    },
    "page_size": {
      "type": "integer"
    },
    "public": {
      "description": "If true (default), a route /module/table/\u003cname\u003e is auto-generated. Set false for embed-only tables.",
      "type": "boolean",
      "nullable": true
    },
    "realtime": {
      "type": "boolean"
    },
    "row_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TableAction"
      }
    },
    "search": {
      "type": "boolean"
    }
  },
  "required": [
    "entity"
  ],
  "additionalProperties": false
}