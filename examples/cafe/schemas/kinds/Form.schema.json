{
  "title": "Form Spec",
  "description": "FormSpec defines an input/edit layout (Frontend §4).\n",
  "type": "object",
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FormAction"
      }
    },
    "entity": {
      "type": "string"
    },
    "mode": {
      "description": "create | edit | view",
      "type": "string"
    },
    "public": {
      "description": "If true (default), a route /module/form/\u003cname\u003e is auto-generated. Set false for embed-only forms.",
      "type": "boolean",
      "nullable": true
    },
    "render": {
      "$ref": "#/$defs/FormRenderDecl",
      "nullable": true
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FormSection"
      }
    },
    "submit": {
      "$ref": "#/$defs/FormSubmit",
      "nullable": true
    }
  },
  "required": [
    "entity"
  ],
  "additionalProperties": false
}