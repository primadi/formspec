{
  "title": "Kanban Spec",
  "description": "KanbanSpec defines a drag-and-drop status board (Frontend §12).\n",
  "type": "object",
  "properties": {
    "card_template": {
      "$ref": "#/$defs/KanbanCard",
      "nullable": true
    },
    "columns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/KanbanColumn"
      }
    },
    "entity": {
      "type": "string"
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_cards_per_column": {
      "type": "integer"
    },
    "position_field": {
      "description": "field storing user-adjustable position (e.g. \"queue_position\")",
      "type": "string"
    },
    "realtime": {
      "description": "default true (§12)",
      "type": "boolean",
      "nullable": true
    },
    "row_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TableAction"
      }
    },
    "search": {
      "type": "boolean"
    },
    "sortable": {
      "description": "enable within-column drag-to-reorder",
      "type": "boolean"
    },
    "status_field": {
      "type": "string"
    }
  },
  "required": [
    "entity",
    "status_field"
  ],
  "additionalProperties": false
}